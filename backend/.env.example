# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer your-token
# OTEL_CONTENT_CAPTURE=metadata  # or comma list: prompts,responses,tool_details
