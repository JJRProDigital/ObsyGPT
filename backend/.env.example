FRONTEND_URL=http://127.0.0.1:5173
DATABASE_URL=postgresql://obsygpt:obsygpt_dev_password@localhost:5432/obsygpt
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SESSION_SECRET=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_URLSAFE
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Optional: Fernet key for encrypting connector credentials.
# If unset, a key is derived from SESSION_SECRET. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=
