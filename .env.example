# ObsyGPT - environment for docker compose (copy to .env and fill in)
# Postgres password used by both the database and the backend connection.
POSTGRES_PASSWORD=obsygpt_dev_password

# LLM provider keys (at least one recommended; OpenRouter is the seeded default provider)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Session signing secret. Generate with: python -c "import secrets; print(secrets.token_urlsafe())"
SESSION_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET

# Public URL of the frontend (used for CORS). Adjust if you expose the app on another host/port.
FRONTEND_URL=http://localhost:3001

# Host port for the web UI (default 3001).
FRONTEND_PORT=3001

# Leave empty to serve the API through the built-in nginx proxy (recommended).
VITE_BACKEND_URL=
